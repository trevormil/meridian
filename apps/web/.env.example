# Chain endpoints
NEXT_PUBLIC_CHAIN_ID=bitbadges_1-1
NEXT_PUBLIC_LCD_URL=http://localhost:1317
NEXT_PUBLIC_RPC_URL=http://localhost:26657
NEXT_PUBLIC_EVM_RPC_URL=http://localhost:8545
NEXT_PUBLIC_EVM_CHAIN_ID=90123
NEXT_PUBLIC_EVM_CHAIN_NAME=BitBadges Local
NEXT_PUBLIC_EVM_CURRENCY_SYMBOL=BADGE

# Aggregator
NEXT_PUBLIC_AGGREGATOR_URL=http://localhost:4001

# USDC denom (single backing coin for all prediction markets)
NEXT_PUBLIC_USDC_DENOM=ibc/uusdc
NEXT_PUBLIC_USDC_DISPLAY_DECIMALS=6
NEXT_PUBLIC_USDC_SYMBOL=USDC

# Test mode — replaces Keplr with deterministic mnemonic signers for Playwright.
# When unset/false, normal Keplr flow. When true, NEXT_PUBLIC_TEST_PERSONAS must
# be a JSON array of {name, address, mnemonic}.
# NEXT_PUBLIC_TEST_MODE=true
# NEXT_PUBLIC_TEST_PERSONAS='[{"name":"alice","address":"bb1...","mnemonic":"..."}]'
