# Caddy config for the Meridian stack. Four subdomains, each terminating
# TLS via Let's Encrypt and reverse-proxying to the right backend.
#
# Required env (set on the host or in the Compose env file):
#   DOMAIN_WEB         meridian.example.com
#   DOMAIN_API         api.meridian.example.com
#   DOMAIN_CHAIN_LCD   lcd.meridian.example.com
#   DOMAIN_CHAIN_RPC   rpc.meridian.example.com
#   ACME_EMAIL         you@example.com  (for Let's Encrypt account)

{
	email {$ACME_EMAIL}
}

# FE — Next.js
# `dynamic a` makes Caddy re-resolve the container IP per request via Docker's
# embedded DNS (127.0.0.11) instead of caching it once at startup. Without
# this, a container restart that hands out a new IP leaves Caddy dialing the
# dead old one → connection refused → 502.
{$DOMAIN_WEB} {
	encode zstd gzip
	reverse_proxy {
		dynamic a {
			name web
			port 3000
			refresh 10s
			resolvers 127.0.0.11
		}
	}
}

# Aggregator REST + WS. Same dynamic-resolution treatment — and WebSocket
# upgrades pass through reverse_proxy automatically over HTTP/1.1.
{$DOMAIN_API} {
	encode zstd gzip

	# Emit CORS at the edge so browsers see the REAL upstream error on 5xx
	# instead of "No 'Access-Control-Allow-Origin' header is present". Without
	# this, when the aggregator hangs/restarts (chain replay, heartbeat sweep
	# starvation, etc.) Caddy generates the 502 itself — the upstream's own
	# `hono/cors` never fires — and the browser blames CORS for what is really
	# an upstream availability failure. Caddy's `header` directive replaces
	# (not appends) so this is also safe when the upstream is healthy and sets
	# the same headers: no duplicate-value CORS rejection.
	# `defer` runs the header directive AFTER reverse_proxy receives the
	# upstream response — without it Caddy sets ACAO before the upstream's
	# own `hono/cors` adds its copy, and the client gets two duplicate
	# values (which some browsers reject as invalid CORS).
	header {
		defer
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Accept, Authorization"
	}
	@cors_preflight method OPTIONS
	respond @cors_preflight 204

	reverse_proxy {
		dynamic a {
			name aggregator
			port 4001
			refresh 10s
			resolvers 127.0.0.11
		}
	}

	# Caddy's top-level `header` directive does NOT apply to error responses
	# generated by Caddy itself (e.g. reverse_proxy upstream EOF -> 502). The
	# error path bypasses the normal handler chain. Re-emit CORS here so the
	# browser surfaces the underlying upstream failure instead of a misleading
	# CORS error. Verified by `docker compose stop aggregator` + curl.
	handle_errors {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Accept, Authorization"
		respond "upstream error {http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}
}

# Chain LCD (Cosmos REST)
{$DOMAIN_CHAIN_LCD} {
	encode zstd gzip
	# Chain runs on the host. host.docker.internal resolves via the
	# extra_hosts entry on the caddy service if you wire it; OR replace with
	# the host gateway IP. Adjust ports if your chain LCD isn't on :1317.
	reverse_proxy http://host.docker.internal:1317
}

# Chain RPC (Tendermint JSON-RPC + WS)
{$DOMAIN_CHAIN_RPC} {
	encode zstd gzip
	reverse_proxy http://host.docker.internal:26657
}
