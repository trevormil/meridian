# Copy to deploy/.env and fill in your values. Compose auto-loads .env from
# the directory it runs in.

# ── Domains ────────────────────────────────────────────────────────────────
DOMAIN_WEB=meridian.example.com
DOMAIN_API=api.meridian.example.com
DOMAIN_CHAIN_LCD=lcd.meridian.example.com
DOMAIN_CHAIN_RPC=rpc.meridian.example.com
ACME_EMAIL=you@example.com

# ── Chain endpoints (inside the aggregator container) ─────────────────────
# The chain runs on the host (systemd-managed bitbadgeschaind). These are
# what the aggregator uses internally — DON'T point them at the public
# subdomains, that'd round-trip through Caddy for every poll.
CHAIN_LCD_URL=http://host.docker.internal:1317
CHAIN_RPC_URL=http://host.docker.internal:26657
CHAIN_WS_URL=ws://host.docker.internal:26657/websocket

# ── Secrets ────────────────────────────────────────────────────────────────
# Directory on the host containing oracle.json + faucet.json + bot.json.
# Mounted read-only into the aggregator container at /app/apps/aggregator/fixtures.
# Recommended location: /etc/meridian/fixtures with mode 0700, owned by the
# user running docker compose.
FIXTURES_DIR=/etc/meridian/fixtures
