# Aggregator service — Bun-runtime indexer + REST + WS + bot + seeder.
# Single-stage build; Bun bundles deps + runs TS directly.
FROM oven/bun:1.3-alpine

WORKDIR /app

# Install root + workspace package manifests first so bun install caches well
# across rebuilds when source changes but deps don't.
COPY package.json bun.lock tsconfig.base.json ./
COPY apps/aggregator/package.json ./apps/aggregator/
COPY apps/web/package.json ./apps/web/
# Link the SDK package — assumes the SDK is published OR vendored as a
# git submodule under bitbadgesjs/. In prod we publish bitbadgesjs-sdk to
# npm and `bun install` resolves it normally; the bun link dance is dev-only.
RUN bun install --frozen-lockfile --production

# Now copy the aggregator source. Fixtures (faucet/bot/oracle mnemonics) are
# mounted at runtime from secrets, NOT baked into the image.
COPY apps/aggregator ./apps/aggregator

WORKDIR /app/apps/aggregator
ENV NODE_ENV=production
ENV PORT=4001

EXPOSE 4001
CMD ["bun", "run", "src/index.ts"]
