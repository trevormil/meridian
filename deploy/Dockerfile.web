# FE — Next.js 14 prod build via Bun. Two-stage: build → slim runtime.
FROM oven/bun:1.3-alpine AS build

WORKDIR /app
COPY package.json bun.lock tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/aggregator/package.json ./apps/aggregator/
# --linker=hoisted produces a standard npm-style node_modules layout with
# .bin symlinks populated. Bun's default --linker=isolated puts everything
# under .bun/<pkg@ver+hash>/ which breaks tools that look for binaries at
# node_modules/.bin/<name>.
RUN bun install --frozen-lockfile --linker=hoisted

COPY apps/web ./apps/web
WORKDIR /app/apps/web

# NEXT_PUBLIC_* vars must be set at BUILD time (Next inlines them into the
# client bundle). Set them via --build-arg in `docker compose build`.
ARG NEXT_PUBLIC_AGGREGATOR_URL
ARG NEXT_PUBLIC_LCD_URL
ARG NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_AGGREGATOR_URL=$NEXT_PUBLIC_AGGREGATOR_URL
ENV NEXT_PUBLIC_LCD_URL=$NEXT_PUBLIC_LCD_URL
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL

RUN bun run build

# ── runtime ────────────────────────────────────────────────────────────────
FROM oven/bun:1.3-alpine AS runtime
WORKDIR /app/apps/web

COPY --from=build /app/node_modules ./../../node_modules
COPY --from=build /app/apps/web/.next ./.next
COPY --from=build /app/apps/web/public ./public
COPY --from=build /app/apps/web/package.json ./
COPY --from=build /app/apps/web/next.config.mjs ./

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000
# With --linker=hoisted in the build stage, node_modules/.bin/next exists
# and `bun run start` (which executes `next start` from package.json) finds it.
CMD ["bun", "run", "start"]
